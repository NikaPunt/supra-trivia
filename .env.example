# Public URL of the site (no trailing slash). Cookies are Secure when this is https.
BASE_URL=https://your.url
PORT=3000
DB_PATH=./data/trivia.db
# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=change-me
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI: ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address to listen on. Leave as is in Docker; use 127.0.0.1 when a reverse proxy runs on the same machine.
# HOST=127.0.0.1
# Platforms without files can give the hosts as inline JSON instead (restart to change):
# HOSTS_JSON={"admins":["you@gmail.com"],"hosts":[]}
# Which senders are reverse proxies whose X-Forwarded-For is believed (addresses or ranges, comma separated).
# The default trusts private addresses, which covers a proxy on the same machine or Docker network.
# Narrow it to your proxy's own range if untrusted devices share that network, e.g. the Docker network's subnet:
#   docker network inspect YOUR_PROXY_NETWORK --format '{{(index .IPAM.Config 0).Subnet}}'
# TRUST_PROXY=172.18.0.0/16
# Finished sessions (with the record of what every team answered) older than this many days are deleted. 0 (the default) keeps them forever.
# GAME_RETENTION_DAYS=0
# The same for the audit log. See docs/LOGGING.md.
# AUDIT_RETENTION_DAYS=0
# info (default): changes, refusals and faults. debug: every read and poll as well. warn: refusals and faults only.
# LOG_LEVEL=info
# Every host gets a copy of the sample trivia (Spooky OOs) the first time they open their dashboard. Set to false to turn that off.
# SEED_SAMPLE=true
# Who may log in is read from this file (see config/hosts.example.json). Admins can control every session.
HOSTS_FILE=./config/hosts.json

# Only for the matching deploy option (see docs/DEPLOY.md):
# PROXY_NETWORK=name_of_your_proxys_docker_network   # root docker-compose.yml
# DOMAIN=trivia.example.com                          # deploy/caddy
# TUNNEL_TOKEN=                                      # deploy/cloudflare-tunnel
