# Public URL of the site (no trailing slash). Cookies are Secure when this is https.
BASE_URL=https://your.url
PORT=3000
DB_PATH=./data/trivia.db
# 32+ random chars: openssl rand -base64 48
SESSION_SECRET=change-me
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
# Authorized redirect URI: ${BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Address to listen on. Leave as is in Docker; use 127.0.0.1 when a reverse proxy runs on the same machine.
# HOST=127.0.0.1
# Platforms without files can give the hosts as inline JSON instead (restart to change):
# HOSTS_JSON={"admins":["you@gmail.com"],"hosts":[]}
# Who may log in is read from this file (see config/hosts.example.json). Admins can control every session.
HOSTS_FILE=./config/hosts.json

# Only for the matching deploy option (see docs/DEPLOY.md):
# PROXY_NETWORK=name_of_your_proxys_docker_network   # root docker-compose.yml
# DOMAIN=trivia.example.com                          # deploy/caddy
# TUNNEL_TOKEN=                                      # deploy/cloudflare-tunnel
